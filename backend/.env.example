# Server Environment & Port
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/stardewedar?schema=public"

# Authentication JWT Secrets (Change these in production!)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
# Verification-code HMAC pepper (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
VERIFICATION_CODE_PEPPER=replace_with_a_random_64_character_hex_secret

# Cloudinary Storage Credentials
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# Email Service (Yahoo SMTP)
YAHOO_EMAIL=your_email@yahoo.com
YAHOO_PASSWORD=your_app_specific_password

# Frontend URL (For CORS & Password Reset links)
FRONTEND_URL=http://localhost:5173

# Public site URL used for sitemap generation and absolute URLs. In production this must be HTTPS.
# Development/test default: http://localhost:5173
SITE_URL=http://localhost:5173

# Client IP source. Use "x-real-ip" in production; dev/test default is "socket".
CLIENT_IP_SOURCE=socket

# Exact comma-separated origins allowed by CORS. No wildcards.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Optional comma-separated DNS server IPs for email-domain validation.
# EMAIL_DNS_SERVERS=1.1.1.1,8.8.8.8

# Public API base URL used by company email attachment links
API_PUBLIC_URL=http://localhost:5000/api

# Admin Panel URL (For deep-linking to requests in notification emails)
ADMIN_URL=''
# Star Dewedar Brand Logo URL (Hosted on Cloudinary for reliable HTML email rendering)
LOGO_URL=''

# Cloudflare Turnstile (backend secret key — server-side only, NEVER expose to frontend)
# Dev default: Cloudflare's official always-pass test secret key
# Production: Replace with your real secret key from the Cloudflare dashboard
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

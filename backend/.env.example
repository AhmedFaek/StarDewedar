# Runtime environment
# NODE_ENV is optional; set it to "production" in a hosted production deployment.
# Any value other than "development" or "test" uses production-style validation.
NODE_ENV=development
PORT=5000

# Required runtime variables (required at startup in every NODE_ENV)
DATABASE_URL="postgresql://user:password@localhost:5432/stardewedar?schema=public"
# Both JWT secrets are required at startup; in production each must be 32+ characters and they must differ.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
# Cloudinary storage credentials, required at startup.
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret
# Yahoo SMTP credentials, required at startup.
YAHOO_EMAIL=your_email@yahoo.com
YAHOO_PASSWORD=your_app_specific_password
FRONTEND_URL=http://localhost:5173
# Required server-side Turnstile secret; do not expose this as a VITE_ variable.
TURNSTILE_SECRET_KEY=replace_with_cloudflare_turnstile_secret_key

# Required in production; optional in development/test (uses a fixed non-secret fallback there).
# Production requires at least 32 characters. Generate a unique value; do not reuse JWT secrets.
VERIFICATION_CODE_PEPPER=replace_with_a_random_64_character_hex_secret

# Required in production; development/test have local defaults.
# SITE_URL must be HTTPS in production. CORS_ORIGINS must contain exact origins, without paths or wildcards.
# CLIENT_IP_SOURCE accepts "socket" or "x-real-ip"; verify the proxy header before selecting x-real-ip.
SITE_URL=http://localhost:5173
CLIENT_IP_SOURCE=socket
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://localhost:4173

# Optional runtime configuration
# Required for public attachment links included in team emails when requests have attachments.
API_PUBLIC_URL=http://localhost:5000/api
# Defaults to http://localhost:3001 if blank; used for team notification links.
ADMIN_URL=''
# Defaults to the configured brand logo if blank.
LOGO_URL=''
# Optional comma-separated DNS server IPs for email-domain validation.
# EMAIL_DNS_SERVERS=<comma-separated-dns-server-ip-addresses>

# Test deployment URL examples (set in the backend deployment environment, not as secrets):
# FRONTEND_URL=https://new.stardewedar.com
# ADMIN_URL=https://admin.stardewedar.com
# SITE_URL=https://new.stardewedar.com
# API_PUBLIC_URL=https://api.stardewedar.com/api
# CORS_ORIGINS=https://new.stardewedar.com,https://admin.stardewedar.com
# CLIENT_IP_SOURCE=x-real-ip

# One-time bootstrap script variables
# The script prompts for these when run interactively. For non-interactive use, set both temporarily,
# then remove them after the bootstrap completes. The password must satisfy the strong-password rules.
# BOOTSTRAP_CONFIRM_DB_NAME=<target_database_name>
# BOOTSTRAP_ADMIN_PASSWORD=<one_time_strong_password>

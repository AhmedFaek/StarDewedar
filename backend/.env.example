# Server Environment & Port
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/stardewedar?schema=public"

# Authentication JWT Secrets (Change these in production!)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars

# Cloudinary Storage Credentials
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# Email Service (Yahoo SMTP)
YAHOO_EMAIL=your_email@yahoo.com
YAHOO_PASSWORD=your_app_specific_password

# Frontend URL (For CORS & Password Reset links)
FRONTEND_URL=http://localhost:5173

# Admin Panel URL (For deep-linking to requests in notification emails)
ADMIN_URL=''
# Star Dewedar Brand Logo URL (Hosted on Cloudinary for reliable HTML email rendering)
LOGO_URL=''

# Cloudflare Turnstile (backend secret key — server-side only, NEVER expose to frontend)
# Dev default: Cloudflare's official always-pass test secret key
# Production: Replace with your real secret key from the Cloudflare dashboard
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

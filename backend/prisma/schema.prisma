generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AttachmentStatus {
  ACTIVE
  PENDING_DELETION
  DELETED
  CLEANUP_FAILED
}

enum CloudinaryCleanupStatus {
  PENDING
  PROCESSING
  FAILED
  COMPLETED
}

enum NotificationRequestType {
  QUOTE
  VISIT
  BOQ
}

enum NotificationAttemptStatus {
  SENDING
  SENT
  FAILED
  UNKNOWN
}

model User {
  id                   String   @id @default(uuid())
  name                 String
  email                String   @unique
  password             String
  whatsapp_number      String?
  phone_number         String?
  company_name         String?
  role                 String   // "super_admin" | "catalog_manager" | "sales_support_manager" | "customer"
  hashed_refresh_token   String?
  reset_password_token           String?
  reset_password_expires         DateTime?
  email_verified                 Boolean   @default(false)
  email_verification_hash        String?
  email_verification_expires_at  DateTime?
  email_verification_attempts    Int       @default(0)
  email_verification_last_sent   DateTime?
  created_at                     DateTime  @default(now())
  updated_at                     DateTime  @updatedAt

  saved_products SavedProduct[]
  conversations  Conversation[]
}

model Category {
  id         String   @id @default(uuid())

  name_en    String
  name_ar    String

  type       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  products Product[]
  projects Project[]
}

model Product {
  id String @id @default(uuid())

  name_en        String
  name_ar        String

  description_en String?
  description_ar String?

  price       Decimal? @db.Decimal(12, 2)
  category_id String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  category       Category         @relation(fields: [category_id], references: [id])
  images         ProductImage[]
  catalogs       ProductCatalog[]
  quote_requests QuoteRequest[]
  saved_by       SavedProduct[]
  messages       Message[]
}

model ProductImage {
  id         String   @id @default(uuid())
  product_id String
  image_url  String
  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model ProductCatalog {
  id         String   @id @default(uuid())
  product_id String

  title_en   String?
  title_ar   String?

  file_url   String
  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model SavedProduct {
  id         String   @id @default(uuid())
  user_id    String
  product_id String
  saved_at   DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
}

model Project {
  id String @id @default(uuid())

  title_en       String
  title_ar       String

  description_en String
  description_ar String

  category_id String?
  client_name String?

  budget     Decimal? @db.Decimal(12, 2)
  start_date DateTime?
  end_date   DateTime?

  location_en String?
  location_ar String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  category Category? @relation(fields: [category_id], references: [id])
  images   ProjectImage[]
}

model ProjectImage {
  id         String   @id @default(uuid())
  project_id String
  image_url  String
  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

model QuoteRequest {
  id String @id @default(uuid())

  first_name String
  last_name  String
  phone      String
  email      String

  product_id String?

  custom_product_name String?
  custom_image_url    String?

  details  String
  file_url String?

  status String
  archived_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assets                        Json?
  notification_attempts         Int       @default(0)
  notification_error_code       String?
  notification_error_message    String?
  notification_last_attempt_at  DateTime?
  notification_lease_expires_at DateTime?
  notification_lease_token      String?
  notification_sent_at          DateTime?
  notification_status           String    @default("pending")
  product_name_en_snapshot      String?
  product_name_ar_snapshot      String?

  product Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  attachments          Attachment[]
  notification_history NotificationAttempt[] @relation("QuoteNotificationAttempts")

  @@index([created_at])
  @@index([archived_at, created_at])
  @@index([notification_status, created_at])
}

model VisitRequest {
  id               String   @id @default(uuid())
  factory_name     String
  factory_activity String
  name             String
  phone_number     String
  whatsapp_number  String?
  email            String
  address          String
  preferred_date   DateTime
  details          String
  file_url         String?
  status           String
  archived_at      DateTime?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  assets                        Json?
  notification_attempts         Int       @default(0)
  notification_error_code       String?
  notification_error_message    String?
  notification_last_attempt_at  DateTime?
  notification_lease_expires_at DateTime?
  notification_lease_token      String?
  notification_sent_at          DateTime?
  notification_status           String    @default("pending")

  attachments          Attachment[]
  notification_history NotificationAttempt[] @relation("VisitNotificationAttempts")

  @@index([created_at])
  @@index([archived_at, created_at])
  @@index([notification_status, created_at])
}

model ContactMessage {
  id              String   @id @default(uuid())
  first_name      String
  last_name       String
  email           String
  phone_number    String?
  whatsapp_number String?
  message         String
  created_at      DateTime @default(now())
}

model BOQRequest {
  id                      String   @id @default(uuid())
  name                    String
  company_name            String
  email                   String
  phone                   String
  project_name            String
  project_location        String
  project_type            String
  boq_file_url            String?
  supporting_docs_urls    String?  // JSON-encoded array of Cloudinary URLs
  additional_requirements String?
  status                  String
  archived_at             DateTime?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  assets                        Json?
  notification_attempts         Int       @default(0)
  notification_error_code       String?
  notification_error_message    String?
  notification_last_attempt_at  DateTime?
  notification_lease_expires_at DateTime?
  notification_lease_token      String?
  notification_sent_at          DateTime?
  notification_status           String    @default("pending")

  attachments          Attachment[]
  notification_history NotificationAttempt[] @relation("BOQNotificationAttempts")

  @@index([created_at])
  @@index([archived_at, created_at])
  @@index([notification_status, created_at])
}

model Attachment {
  id                String           @id @default(uuid())
  quote_request_id  String?
  visit_request_id  String?
  boq_request_id    String?
  original_filename String
  mime_type         String
  file_size         Int
  public_id         String
  resource_type     String
  delivery_type     String
  status            AttachmentStatus @default(ACTIVE)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  quote_request QuoteRequest? @relation(fields: [quote_request_id], references: [id], onDelete: SetNull)
  visit_request VisitRequest? @relation(fields: [visit_request_id], references: [id], onDelete: SetNull)
  boq_request   BOQRequest?   @relation(fields: [boq_request_id], references: [id], onDelete: SetNull)

  cleanup_operations  CloudinaryCleanupOperation[]
  email_access_tokens EmailAttachmentAccessToken[]

  @@unique([public_id, resource_type, delivery_type])
  @@index([quote_request_id])
  @@index([visit_request_id])
  @@index([boq_request_id])
  @@index([status, created_at])
}

model CloudinaryCleanupOperation {
  id               String                  @id @default(uuid())
  attachment_id    String?
  request_type     NotificationRequestType?
  request_id       String?
  public_id        String
  resource_type    String
  delivery_type    String
  status           CloudinaryCleanupStatus @default(PENDING)
  processing_token String?                 @unique
  attempt_count    Int                     @default(0)
  last_error       String?
  created_at       DateTime                @default(now())
  updated_at       DateTime                @updatedAt
  completed_at     DateTime?

  attachment Attachment? @relation(fields: [attachment_id], references: [id], onDelete: SetNull)

  @@unique([public_id, resource_type, delivery_type])
  @@index([status, created_at])
  @@index([attachment_id])
  @@index([request_type, request_id])
}

model NotificationAttempt {
  id               String                    @id @default(uuid())
  request_type     NotificationRequestType
  request_id       String
  attempt_number   Int
  quote_request_id String?
  visit_request_id String?
  boq_request_id   String?
  status           NotificationAttemptStatus @default(SENDING)
  started_at       DateTime                  @default(now())
  completed_at     DateTime?
  error_code       String?

  quote_request QuoteRequest? @relation("QuoteNotificationAttempts", fields: [quote_request_id], references: [id], onDelete: SetNull)
  visit_request VisitRequest? @relation("VisitNotificationAttempts", fields: [visit_request_id], references: [id], onDelete: SetNull)
  boq_request   BOQRequest?   @relation("BOQNotificationAttempts", fields: [boq_request_id], references: [id], onDelete: SetNull)

  email_access_tokens EmailAttachmentAccessToken[]

  @@unique([request_type, request_id, attempt_number])
  @@index([request_type, request_id, started_at])
  @@index([status, started_at])
}

model EmailAttachmentAccessToken {
  id                      String    @id @default(uuid())
  attachment_id           String
  notification_attempt_id String
  token_hash              String    @unique @db.VarChar(64)
  issued_at               DateTime  @default(now())
  expires_at              DateTime
  revoked_at              DateTime?

  attachment           Attachment          @relation(fields: [attachment_id], references: [id], onDelete: Restrict)
  notification_attempt NotificationAttempt @relation(fields: [notification_attempt_id], references: [id], onDelete: Restrict)

  @@index([attachment_id, issued_at])
  @@index([notification_attempt_id])
  @@index([expires_at, revoked_at])
  @@unique([attachment_id, notification_attempt_id])
}

model IdempotencyRecord {
  id               String   @id
  request_type     String
  key              String
  fingerprint      String
  status           String
  request_id       String?
  assets           Json?
  lease_token      String
  lease_expires_at DateTime
  attempt          Int      @default(1)
  created_at       DateTime @default(now())
  updated_at       DateTime

  @@unique([request_type, key])
  @@index([status, lease_expires_at])
}

// ─── Support Messaging ────────────────────────────────────────────────────────

model Conversation {
  id          String   @id @default(uuid())
  customer_id String
  subject     String   @db.VarChar(100)
  status      String   @default("OPEN")  // "OPEN" | "CLOSED"

  last_message_at          DateTime?
  last_message_sender_type String?   // "CUSTOMER" | "ADMIN" | "SYSTEM"

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer User      @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([customer_id])
  @@index([status])
  @@index([last_message_at])
}

model Message {
  id              String   @id @default(uuid())
  conversation_id String
  sender_type     String   // "CUSTOMER" | "ADMIN" | "SYSTEM"
  sender_id       String?  // userId (null for SYSTEM messages)
  message_type    String   @default("TEXT")  // "TEXT" | "PRODUCT"
  content         String?  @db.VarChar(2000)
  product_id      String?  // populated when message_type = "PRODUCT"

  created_at DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([conversation_id])
  @@index([created_at])
}

// ─── Website Analytics ────────────────────────────────────────────────────────

model AnalyticsSession {
  id            String   @id @default(uuid())

  // Anonymous session identifier generated on the client (UUID v4 stored in localStorage)
  session_id    String   @unique

  // Hashed IP address for abuse prevention only — raw IP is never stored
  ip_hash       String?

  first_seen_at DateTime @default(now())
  last_seen_at  DateTime @default(now())

  created_at    DateTime @default(now())

  @@index([session_id])
  @@index([first_seen_at])
  @@index([last_seen_at])
}

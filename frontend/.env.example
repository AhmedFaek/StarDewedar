# Test deployment build values. Override these for local development or production builds.
VITE_API_URL=https://api.stardewedar.com/api

# Customer site origin, used for canonical URLs, Open Graph metadata, and page SEO.
# Keep the value free of a trailing slash. Production builds should use the production site origin.
VITE_SITE_URL=https://new.stardewedar.com

# Public Cloudflare Turnstile site key for the configured domain (not a secret).
VITE_TURNSTILE_SITE_KEY=replace_with_cloudflare_turnstile_site_key

VITE_API_URL=http://localhost:5000/api

# Production site URL — used for canonical URLs, Open Graph, and sitemap references
# Development: leave empty (falls back to https://stardewedar.com)
# Production: set to your exact domain (no trailing slash)
VITE_SITE_URL=https://stardewedar.com

# Cloudflare Turnstile site key (public — safe to expose to the browser)
# Dev default: Cloudflare's official always-pass test site key
# Production: Replace with your real site key from the Cloudflare dashboard
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
